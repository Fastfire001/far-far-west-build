{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["vite/client"],
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./src/*"],
      "@data/*": ["../data/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "../data/**/*.json"]
}
